{
    "name": "leo-t/flarum-notify-push",
    "description": "Push notifications to WeCom, DingTalk, ServerChan, Email and Webhook when forum events occur.",
    "keywords": [
        "flarum",
        "notification",
        "push",
        "wecom",
        "dingtalk",
        "serverchan",
        "webhook"
    ],
    "version": "1.0.0",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Leo",
            "email": "Leo.lty0511@gmail.com"
        }
    ],
    "require": {
        "flarum/core": "^1.0.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "LeoT\\NotifyPush\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Notify Push",
            "icon": {
                "name": "fas fa-bell",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
